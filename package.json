{
  "name": "hcl-dx-compose-installer",
  "version": "2.0.2",
  "private": true,
  "description": "Web installer for HCL DX Compose: guides you from the environment (your cluster, a local PC or AWS) to a ready-to-run installation (scripts, RUNBOOK.md and, for the webinar, a Word script)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.mjs",
    "preview": "vite build && node server/index.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "docx": "9.15.3",
    "pdfmake": "0.3.12",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.2.1",
    "playwright": "1.56.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.6"
  }
}
